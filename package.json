{
  "name": "techforge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"node server/index.js\"",
    "web": "vite",
    "api": "node server/index.js",
    "build": "vite build",
    "start": "vite build && NODE_ENV=production node server/index.js",
    "deploy": "PAGES_BASE=/techforge/ vite build && cp dist/index.html dist/404.html && touch dist/.nojekyll && npx gh-pages@6.3.0 -d dist -t"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "dompurify": "^3.5.0",
    "express": "^4.21.2",
    "highlight.js": "^11.10.0",
    "jsdom": "^25.0.1",
    "lucide-vue-next": "^1.0.0",
    "markdown-it": "^14.1.0",
    "rss-parser": "^3.13.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "vite": "^6.0.7"
  }
}
